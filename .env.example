# Copier ce fichier en .env et remplir les valeurs (le fichier .env n'est jamais commité).

# Base locale lancée par `docker compose up -d`
POSTGRES_USER=ddb
POSTGRES_PASSWORD=
POSTGRES_DB=damebijoux
DATABASE_URL=postgresql://ddb:MOT_DE_PASSE@127.0.0.1:5432/damebijoux

# Signe les cookies de session du back-office. Générer une valeur avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Compte créé par `npm run db:seed` (facultatif, pratique en local)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
