// Schéma Prisma — Dame de Bijoux World
// Base PostgreSQL : Docker en local, Neon (via Vercel) en ligne.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Administrateur : tout l'espace admin. Utilisateur : catalogue et annonces, sans les pages du site ni les comptes.
enum Role {
  ADMIN
  UTILISATEUR
}

/// Comptes du back-office (/admin).
model AdminUser {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  role           Role      @default(UTILISATEUR)
  /// Incrémenté à chaque changement de mot de passe : les sessions ouvertes avant deviennent invalides.
  sessionVersion Int       @default(0)
  /// Tentatives de connexion ratées d'affilée ; le compte se bloque un moment au-delà de la limite.
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  /// Identifiant dans les adresses : /selection?categorie=bracelets
  slug      String    @unique
  label     String
  /// Libellé court affiché en pastille sur les photos des cartes produit.
  tag       String
  blurb     String
  /// Pas encore de fiches en ligne : la catégorie se commande sur demande.
  onRequest Boolean   @default(false)
  /// Photo de la tuile de la catégorie sur l'accueil.
  image     String?
  position  Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id           String           @id @default(cuid())
  slug         String           @unique
  name         String
  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId   String
  /// Prix de vente au détail, en FCFA.
  price        Int
  /// Prix promotionnel en FCFA : affiché à la place du prix, l'ancien prix barré, tant que la promotion court.
  promoPrice   Int?
  /// Fin de la promotion (dernière seconde du jour choisi, heure de Lomé) ; vide : jusqu'à ce qu'on la retire.
  promoEndsAt  DateTime?
  isNew        Boolean          @default(false)
  /// Décoché : la fiche reste dans le back-office mais disparaît du site.
  published    Boolean          @default(true)
  short        String
  description  String
  details      String[]
  /// Choix proposé au client (coloris, finition, modèle…) : nom affiché et formes accordées,
  /// par exemple « Coloris », « coloris » (5 coloris), « Choisir le coloris ».
  optionName   String?
  optionPlural String?
  optionChoose String?
  position     Int              @default(0)
  images       ProductImage[]
  variants     ProductVariant[]
  posts        Post[]
  /// Fiche de l'accueil qui met cet article en avant sur sa photo.
  homeFeatures HomePage[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        String           @id @default(cuid())
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  alt       String
  position  Int              @default(0)
  variants  ProductVariant[]

  @@index([productId])
}

/// Une valeur du choix proposé (« Dorée », « Noir & doré »…), avec la photo à montrer quand elle est choisie.
model ProductVariant {
  id        String        @id @default(cuid())
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  label     String
  image     ProductImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  imageId   String?
  position  Int           @default(0)

  @@index([productId])
}

/// Bandeau en haut du site (id « bandeau ») et fenêtre à l'ouverture (id « fenetre ») : une fiche de chaque.
model Announcement {
  id        String    @id
  /// Coché : affiché sur le site, entre `startsAt` et `endsAt` quand elles sont renseignées.
  enabled   Boolean   @default(false)
  /// Titre de la fenêtre (le bandeau n'en a pas).
  title     String    @default("")
  text      String    @default("")
  /// Photo de la fenêtre.
  image     String?
  /// Bouton ou lien : libellé et adresse (page du site comme « /selection », ou adresse complète).
  linkLabel String    @default("")
  linkUrl   String    @default("")
  /// Couleur du bandeau : « nuit », « or » ou « rubis ».
  tone      String    @default("nuit")
  /// Premier jour (dès minuit) et dernier jour (jusqu'à minuit), heure de Lomé ; vides : sans limite.
  startsAt  DateTime?
  endsAt    DateTime?
  updatedAt DateTime  @updatedAt
}

/// Actualités et arrivages, publiés sur /actualites.
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  /// Une ou deux phrases : liste des actualités, Google et aperçus de partage.
  excerpt     String
  /// Texte complet ; une ligne vide sépare deux paragraphes.
  body        String
  image       String?
  published   Boolean   @default(true)
  /// Date affichée sur l'actualité ; la liste va de la plus récente à la plus ancienne.
  publishedAt DateTime  @default(now())
  /// Articles présentés avec l'actualité (un arrivage, une sélection…).
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Coordonnées et horaires de la boutique : une seule fiche (id « boutique »).
/// Sans fiche, le site affiche les valeurs par défaut de src/lib/boutique.ts.
model ShopSettings {
  id        String   @id @default("boutique")
  /// Numéro affiché et appelé, par exemple « +228 92 28 63 63 ».
  phone     String
  /// Numéro WhatsApp, chiffres seuls avec l'indicatif : « 22892286363 ».
  whatsapp  String
  /// Quartier et repère : « Adewui, dans la VON de l'église baptiste ».
  address   String
  city      String
  /// Lien du plan ; vide : recherche Google Maps sur l'adresse.
  mapsUrl   String   @default("")
  hours     String
  /// Phrase sur le retrait et la livraison, affichée sur les fiches article.
  delivery  String
  /// Compte TikTok, sans « @ ».
  tiktok    String
  updatedAt DateTime @updatedAt
}

/// Rubriques de la FAQ (« Commander », « Paiement & livraison »…).
model FaqSection {
  id        String        @id @default(cuid())
  title     String
  position  Int           @default(0)
  questions FaqQuestion[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model FaqQuestion {
  id        String     @id @default(cuid())
  /// Une rubrique qui contient encore des questions ne peut pas être supprimée.
  section   FaqSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  sectionId String
  question  String
  /// Une ligne vide sépare deux paragraphes.
  answer    String
  /// Reprise dans le bloc « Vos questions » de l'accueil (trois au plus).
  onHome    Boolean    @default(false)
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([sectionId])
}

/// Textes et photos de l'accueil : une seule fiche (id « accueil »).
/// Sans fiche, le site affiche les valeurs par défaut de src/lib/accueil.ts.
model HomePage {
  id              String   @id @default("accueil")
  /// Titre du haut de page ; un mot entre astérisques (*belles*) s'affiche en italique.
  heroTitle       String
  heroText        String
  heroImage       String
  heroImageAlt    String
  /// Petite photo en médaillon ; vide : pas de médaillon.
  heroImage2      String?
  heroImage2Alt   String   @default("")
  /// Article signalé sur la photo (vignette avec son nom et son prix).
  featured        Product? @relation(fields: [featuredId], references: [id], onDelete: SetNull)
  featuredId      String?
  wholesaleTitle  String
  wholesaleText   String
  wholesalePoints String[]
  updatedAt       DateTime @updatedAt
}
